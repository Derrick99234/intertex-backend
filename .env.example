# JWT Secrets (generate with: openssl rand -hex 64)
ADMIN_JWT_SECRET=
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_RESET_SECRET=

# MongoDB
DB_URI=

# Super Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# Server
PORT=2025

# Paystack (use test keys for development)
PAYSTACK_SECRET_KEY=
TEST_PAYSTACK_SECRET_KEY=

# Email (SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3000
